// ricescape:managed — generated by `ropes mode` ({{name}}). Edits will be overwritten.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "{{logo_type}}",
    "source": "{{logo_path}}",
    "color": {
      "1": "{{helm_ansi}}",
      "2": "{{helm_shade_ansi}}"
    },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "{{text_alt_ansi}}",
      "title": "{{text_ansi}}"
    }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[1;{{helm_ansi}}m{{tagline}}\u001b[0m" },
    { "type": "custom", "format": "\u001b[{{text_ansi}}m{{name}}\u001b[0m" },
    "break",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "break",
    "colors"
  ]
}
