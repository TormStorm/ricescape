# ricescape:managed — generated by `ropes mode` ({{name}}). Edits will be overwritten.
# Placeholder until the XP-drop notifications are built in Quickshell.

font={{ui_font}} 11
background-color={{panel}}
text-color={{text}}
border-color={{border_light}}
progress-color=over {{accent}}
border-size=3
border-radius=0
padding=10
margin=12
width=360
anchor=top-right
default-timeout=5000
max-visible=4

[urgency=critical]
border-color={{bad}}
default-timeout=0

[mode=do-not-disturb]
invisible=1
