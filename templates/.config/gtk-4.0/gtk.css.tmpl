/* ricescape:managed — generated by `ropes mode` ({{name}}). Edits will be overwritten. */
/* Recolours Adwaita and libadwaita apps. Restart open apps to see changes. */

@define-color accent_color {{accent}};
@define-color accent_bg_color {{accent}};
@define-color accent_fg_color {{text_shadow}};

@define-color window_bg_color {{panel_dark}};
@define-color window_fg_color {{fg}};
@define-color view_bg_color {{panel_dark}};
@define-color view_fg_color {{fg}};
@define-color headerbar_bg_color {{panel}};
@define-color headerbar_fg_color {{text}};
@define-color headerbar_backdrop_color {{panel_dark}};
@define-color sidebar_bg_color {{panel}};
@define-color sidebar_fg_color {{fg}};
@define-color card_bg_color {{panel}};
@define-color card_fg_color {{fg}};
@define-color popover_bg_color {{panel}};
@define-color popover_fg_color {{fg}};
@define-color dialog_bg_color {{panel}};
@define-color dialog_fg_color {{fg}};

@define-color destructive_bg_color {{bad}};
@define-color success_bg_color {{good}};
@define-color warning_bg_color {{warn}};
@define-color error_bg_color {{bad}};

/* GTK 3 / Adwaita names */
@define-color theme_bg_color {{panel_dark}};
@define-color theme_fg_color {{fg}};
@define-color theme_base_color {{panel_dark}};
@define-color theme_text_color {{fg}};
@define-color theme_selected_bg_color {{accent}};
@define-color theme_selected_fg_color {{text_shadow}};
