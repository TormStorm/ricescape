// ricescape:managed — generated by `ropes mode` ({{name}}). Edits will be overwritten.

input {
    keyboard {
        xkb {
            layout "{{keyboard_layout}}"
        }
    }
}

layout {
    border {
        width 3
        active-color "{{border_light}}"
        inactive-color "{{border_dark}}"
    }
}
